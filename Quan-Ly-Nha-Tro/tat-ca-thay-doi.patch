+++ b/Quan-Ly-Nha-Tro/db-migration/V2__them_kiem_duyet_bai_dang.sql
@@ -0,0 +1,51 @@
+-- =====================================================================
+-- MIGRATION: Bo sung kiem duyet bai dang (DANG_TIN)
+-- Chay 1 lan tren SQL Server (project dung spring.jpa.hibernate.ddl-auto=none
+-- nen KHONG tu tao cot moi - phai chay script nay thu cong truoc khi dung
+-- chuc nang "Duyet bai dang" trong Admin).
+-- =====================================================================
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns
+    WHERE object_id = OBJECT_ID('DANG_TIN') AND name = 'trangThaiDuyet'
+)
+BEGIN
+    ALTER TABLE DANG_TIN ADD trangThaiDuyet VARCHAR(20) NOT NULL
+        CONSTRAINT DF_DANGTIN_TRANGTHAIDUYET DEFAULT 'CHO_DUYET';
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns
+    WHERE object_id = OBJECT_ID('DANG_TIN') AND name = 'lyDoTuChoi'
+)
+BEGIN
+    ALTER TABLE DANG_TIN ADD lyDoTuChoi NVARCHAR(500) NULL;
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns
+    WHERE object_id = OBJECT_ID('DANG_TIN') AND name = 'maNguoiDuyet'
+)
+BEGIN
+    ALTER TABLE DANG_TIN ADD maNguoiDuyet INT NULL;
+    ALTER TABLE DANG_TIN ADD CONSTRAINT FK_DANGTIN_NGUOIDUYET
+        FOREIGN KEY (maNguoiDuyet) REFERENCES NGUOI_DUNG(maNguoiDung);
+END
+GO
+
+IF NOT EXISTS (
+    SELECT 1 FROM sys.columns
+    WHERE object_id = OBJECT_ID('DANG_TIN') AND name = 'ngayDuyet'
+)
+BEGIN
+    ALTER TABLE DANG_TIN ADD ngayDuyet DATETIME2 NULL;
+END
+GO
+
+-- Cac bai dang da ton tai TRUOC khi co tinh nang kiem duyet nay: coi nhu
+-- da duyet san, tranh viec toan bo tin dang cu bi "an" khoi trang cong khai
+-- ngay sau khi migrate (PhongChiTietService moi chi lay bai DA_DUYET).
+UPDATE DANG_TIN SET trangThaiDuyet = 'DA_DUYET' WHERE trangThaiDuyet = 'CHO_DUYET';
+GO
