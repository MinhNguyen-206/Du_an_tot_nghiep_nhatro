# Copy file nay thanh "application-local.properties" (cung thu muc) roi dien
# mat khau that cua ban. File application-local.properties da duoc .gitignore,
# se khong bao gio bi commit len GitHub.
#
# Cach dung: chay app voi profile "local"
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
# hoac set bien moi truong DB_URL / DB_USERNAME / DB_PASSWORD truoc khi chay.

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuanLyNhaTro;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_real_password_here
