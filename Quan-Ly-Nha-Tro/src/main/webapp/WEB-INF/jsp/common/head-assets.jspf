<%@ page pageEncoding="UTF-8" %>
<%-- =========================================================
     COMMON HEAD ASSETS
     Tailwind CDN + config, FontAwesome, font chữ dùng chung.
     Include ở đầu <head> của mọi trang bằng:
     <%@ include file="/WEB-INF/jsp/common/head-assets.jspf" %>
     Trang include file này KHÔNG được tự khai báo lại <script src="tailwind">
     hay link FontAwesome nữa để tránh load trùng.
========================================================= --%>

<!-- Tailwind -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- Font Awesome -->
<link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<!-- Font chữ dùng chung -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
        href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: '#ff641e',
                    brandDark: '#e9510d',
                    cream: '#fff7f1',
                    navy: '#172033'
                },
                fontFamily: {
                    sans: ['Be Vietnam Pro', 'sans-serif']
                },
                boxShadow: {
                    soft: '0 8px 30px rgba(38, 32, 25, .08)',
                    card: '0 5px 20px rgba(38, 32, 25, .07)'
                }
            }
        }
    }
</script>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Be Vietnam Pro', sans-serif;
        background: #f7f7f6;
        color: #172033;
    }

    .hide-scroll::-webkit-scrollbar {
        display: none;
    }

    .hide-scroll {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
