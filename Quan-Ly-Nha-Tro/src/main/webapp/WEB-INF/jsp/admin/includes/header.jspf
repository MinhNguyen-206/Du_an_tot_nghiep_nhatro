<%@ page pageEncoding="UTF-8" %>
<% response.setCharacterEncoding("UTF-8"); %>
<%
    String currentPath = request.getRequestURI();
    String contextPath = request.getContextPath();
    if (contextPath != null && !contextPath.isEmpty()) {
        currentPath = currentPath.substring(contextPath.length());
    }
%>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
/* ── Topbar ── */
.topbar-left  { display: flex; align-items: center; gap: 12px; }
.topbar-right { display: flex; align-items: center; gap: 8px;  }

.topbar-breadcrumb { font-size: 13px; color: #64748b; font-weight: 500; display: flex; align-items: center; gap: 4px; }

/* search */
.topbar-search { position: relative; display: flex; align-items: center; }
.topbar-search-icon { position: absolute; left: 12px; color: #9ca3af; font-size: 13px; pointer-events: none; }
.topbar-search-input {
    width: 220px; height: 36px;
    border: 1px solid #e2e8f0; border-radius: 10px;
    background: #f8fafc; padding: 0 12px 0 34px;
    font-size: 13px; outline: none; color: #0f172a;
    transition: border .15s;
}
.topbar-search-input:focus { border-color: #6366f1; background: #fff; }

/* icon btn */
.topbar-icon-btn {
    position: relative; width: 38px; height: 38px;
    border: none; border-radius: 10px; background: #f1f5f9;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 17px; color: #374151; transition: background .15s;
}
.topbar-icon-btn:hover { background: #e2e8f0; }
.topbar-badge {
    position: absolute; top: -4px; right: -4px;
    min-width: 18px; height: 18px; padding: 0 4px;
    border-radius: 9px; background: #ef4444;
    color: #fff; font-size: 10px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid #fff;
}

/* user btn */
.topbar-user-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 4px 10px 4px 4px; border-radius: 12px;
    border: none; background: transparent; cursor: pointer;
    transition: background .15s;
}
.topbar-user-btn:hover { background: #f1f5f9; }
.topbar-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; }
.topbar-user-info { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.3; }
.topbar-user-info strong { font-size: 13px; font-weight: 600; color: #0f172a; }
.topbar-user-info span   { font-size: 11px; color: #64748b; }
.topbar-chevron { font-size: 11px; color: #9ca3af; margin-left: 2px; }

/* dropdowns */
.topbar-notif-wrap,
.topbar-user-wrap { position: relative; }
.topbar-dropdown {
    position: absolute; right: 0; top: calc(100% + 8px);
    background: #fff; border-radius: 14px;
    box-shadow: 0 8px 30px rgba(0,0,0,.10);
    border: 1px solid #e2e8f0;
    opacity: 0; visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s, transform .18s, visibility .18s;
    z-index: 999;
}
.topbar-dropdown.show { opacity: 1; visibility: visible; transform: translateY(0); }

/* notif dropdown */
.notif-dropdown { width: 300px; }
.dropdown-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 16px 10px; border-bottom: 1px solid #f0f0f0;
    font-size: 13px; font-weight: 600; color: #0f172a;
}
.dropdown-header a { font-size: 12px; color: #6366f1; font-weight: 500; text-decoration: none; }
.notif-list { max-height: 280px; overflow-y: auto; }
.notif-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 16px; text-decoration: none; color: inherit;
    transition: background .12s;
}
.notif-item:hover { background: #f9fafb; }
.notif-item.unread { background: #f0f4ff; }
.notif-icon {
    width: 32px; height: 32px; border-radius: 50%;
    background: #e0e7ff; color: #6366f1; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
}
.notif-body { display: flex; flex-direction: column; gap: 2px; }
.notif-body strong { font-size: 12px; font-weight: 600; color: #0f172a; }
.notif-body span   { font-size: 11px; color: #64748b; }
.notif-empty { padding: 20px 16px; text-align: center; color: #9ca3af; font-size: 13px; }

/* user dropdown */
.user-dropdown { width: 240px; }
.dropdown-user-header { display: flex; align-items: center; gap: 12px; padding: 14px 16px 12px; }
.dropdown-avatar-lg { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; flex-shrink: 0; }
.dropdown-user-header strong { font-size: 13px; font-weight: 600; color: #0f172a; display: block; }
.dropdown-user-header span   { font-size: 11px; color: #64748b; display: block; word-break: break-all; }
.dropdown-divider { height: 1px; background: #f0f0f0; margin: 4px 0; }
.dropdown-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 16px; font-size: 13px; font-weight: 500;
    color: #374151; text-decoration: none;
    background: none; border: none; width: 100%; cursor: pointer;
    transition: background .12s;
}
.dropdown-item:hover { background: #f3f4f6; color: #0f172a; }
.dropdown-item.danger { color: #dc2626; }
.dropdown-item.danger:hover { background: #fef2f2; }
.dropdown-item i { width: 18px; text-align: center; }

@media (max-width: 768px) {
    .topbar-search-input { width: 140px; }
    .topbar-user-info    { display: none; }
    .topbar-breadcrumb   { display: none; }
}
</style>


<!-- ── SIDEBAR ── -->
<div class="sidebar" id="adminSidebar">

    <div class="brand">
        <div class="brand-logo"><i class="bi bi-house-heart-fill"></i></div>
        <span>Room Connect</span>
        <small>ADMIN CONTROL CENTER</small>
    </div>

    <div class="nav-title">Tổng quan</div>
    <a class="side-link <%= currentPath.equals("/admin/dashboard") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/dashboard">
        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
    </a>

    <div class="nav-title">Kiểm duyệt</div>
    <a class="side-link <%= currentPath.equals("/admin/posts") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/posts">
        <i class="bi bi-house-check"></i><span>Duyệt bài</span>
        <span class="badge-menu">12</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/ekyc") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/ekyc">
        <i class="bi bi-person-vcard"></i><span>eKYC</span>
        <span class="badge-menu">7</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/reviews") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/reviews">
        <i class="bi bi-star"></i><span>Đánh giá</span>
    </a>

    <div class="nav-title">Quản trị</div>
    <a class="side-link <%= currentPath.equals("/admin/users") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/users">
        <i class="bi bi-people"></i><span>Người dùng</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/complaints") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/complaints">
        <i class="bi bi-flag"></i><span>Khiếu nại</span>
        <span class="badge-menu">5</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/categories") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/categories">
        <i class="bi bi-tags"></i><span>Danh mục</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/blog") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/blog">
        <i class="bi bi-newspaper"></i><span>Blog</span>
    </a>

    <div class="nav-title">Tài chính & hệ thống</div>
    <a class="side-link <%= currentPath.equals("/admin/statistics") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/statistics">
        <i class="bi bi-bar-chart"></i><span>Thống kê</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/revenue") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/revenue">
        <i class="bi bi-cash-stack"></i><span>Doanh thu</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/transactions") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/transactions">
        <i class="bi bi-receipt"></i><span>Giao dịch & hóa đơn</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/premium") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/premium">
        <i class="bi bi-gem"></i><span>Premium</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/notifications") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/notifications">
        <i class="bi bi-bell"></i><span>Thông báo</span>
    </a>
    <a class="side-link <%= currentPath.equals("/admin/activity-log") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/activity-log">
        <i class="bi bi-clipboard-data"></i><span>Audit Log</span>
    </a>

    <div class="nav-title">AI Admin</div>
    <a class="side-link <%= currentPath.equals("/admin/ai") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/ai">
        <i class="bi bi-robot"></i><span>Trợ lý AI</span>
    </a>

    <a class="side-link" href="${pageContext.request.contextPath}/">
        <i class="bi bi-house-door"></i><span>Về trang chủ</span>
    </a>

</div>

<!-- ── MAIN ── -->
<div class="main" id="adminMain">

    <div class="topbar">
        <div class="topbar-left">
            <span class="topbar-breadcrumb">
                <i class="bi bi-house-door"></i>&nbsp;Admin
            </span>
        </div>

        <div class="topbar-right">
            <!-- Search -->
            <div class="topbar-search">
                <i class="bi bi-search topbar-search-icon"></i>
                <input class="topbar-search-input" type="text" placeholder="Tìm kiếm nhanh...">
            </div>

            <!-- Notifications -->
            <div class="topbar-notif-wrap" id="topbarNotifWrap">
                <button class="topbar-icon-btn" id="topbarNotifBtn" title="Thông báo">
                    <i class="bi bi-bell"></i>
                    <span class="topbar-badge" id="topbarNotifBadge" style="display:none">0</span>
                </button>
                <div class="topbar-dropdown notif-dropdown" id="topbarNotifDropdown">
                    <div class="dropdown-header">
                        <span>Thông báo</span>
                        <a href="${pageContext.request.contextPath}/admin/notifications">Xem tất cả</a>
                    </div>
                    <div class="notif-list" id="topbarNotifList">
                        <div class="notif-empty">Đang tải...</div>
                    </div>
                </div>
            </div>

            <!-- User -->
            <div class="topbar-user-wrap" id="topbarUserWrap">
                <button class="topbar-user-btn" id="topbarUserBtn">
                    <img id="topbarAvatar"
                         src="https://ui-avatars.com/api/?name=AD&background=6366f1&color=fff&size=64"
                         alt="Avatar" class="topbar-avatar">
                    <div class="topbar-user-info">
                        <strong id="topbarUserName">Administrator</strong>
                        <span id="topbarUserRole">Super Admin</span>
                    </div>
                    <i class="bi bi-chevron-down topbar-chevron"></i>
                </button>
                <div class="topbar-dropdown user-dropdown" id="topbarUserDropdown">
                    <div class="dropdown-user-header">
                        <img id="topbarAvatarLg"
                             src="https://ui-avatars.com/api/?name=AD&background=6366f1&color=fff&size=64"
                             alt="Avatar" class="dropdown-avatar-lg">
                        <div>
                            <strong id="topbarUserNameLg">Administrator</strong>
                            <span id="topbarUserEmailLg">admin@qlnt.vn</span>
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="${pageContext.request.contextPath}/profile" class="dropdown-item">
                        <i class="bi bi-person-circle"></i> Hồ sơ cá nhân
                    </a>
                    <a href="${pageContext.request.contextPath}/admin/dashboard" class="dropdown-item">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                    <a href="${pageContext.request.contextPath}/" class="dropdown-item">
                        <i class="bi bi-house-door"></i> Về trang chủ
                    </a>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item danger" id="topbarLogoutBtn">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="content">

<script>
(function () {
    var CP = '${pageContext.request.contextPath}';

    var token = localStorage.getItem('token');
    var user  = null;
    try { user = JSON.parse(localStorage.getItem('user') || 'null'); } catch(e){}

    if (!token || !user) { window.location.href = CP + '/login'; return; }

    var maVaiTro  = user.vaiTro ? user.vaiTro.maVaiTro  : user.maVaiTro;
    var tenVaiTro = user.vaiTro ? user.vaiTro.tenVaiTro  : user.tenVaiTro;
    var isAdmin   = maVaiTro === 1 || maVaiTro === '1'
                 || (tenVaiTro && tenVaiTro.toLowerCase().indexOf('admin') > -1);
    if (!isAdmin) { window.location.href = CP + '/'; return; }

    var hoTen = user.hoTen || user.email || 'Administrator';
    var email = user.email || '';
    var avatarSrc = user.avatar
        ? user.avatar
        : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(hoTen) + '&background=6366f1&color=fff&size=64';

    function setText(id, v){ var e=document.getElementById(id); if(e) e.textContent=v; }
    function setSrc(id, v) { var e=document.getElementById(id); if(e) e.src=v; }

    setText('topbarUserName',    hoTen);
    setText('topbarUserRole',    tenVaiTro || 'Super Admin');
    setText('topbarUserNameLg',  hoTen);
    setText('topbarUserEmailLg', email);
    setSrc('topbarAvatar',   avatarSrc);
    setSrc('topbarAvatarLg', avatarSrc);

    /* Dropdown user */
    var userBtn  = document.getElementById('topbarUserBtn');
    var userDrop = document.getElementById('topbarUserDropdown');
    if (userBtn && userDrop) {
        userBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            userDrop.classList.toggle('show');
            var nd = document.getElementById('topbarNotifDropdown');
            if (nd) nd.classList.remove('show');
        });
    }

    /* Dropdown notifications */
    var notifBtn  = document.getElementById('topbarNotifBtn');
    var notifDrop = document.getElementById('topbarNotifDropdown');
    if (notifBtn && notifDrop) {
        notifBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            var willOpen = !notifDrop.classList.contains('show');
            notifDrop.classList.toggle('show');
            if (userDrop) userDrop.classList.remove('show');
            if (willOpen) loadNotifications();
        });
    }

    document.addEventListener('click', function(e) {
        if (userDrop  && !e.target.closest('#topbarUserWrap'))  userDrop.classList.remove('show');
        if (notifDrop && !e.target.closest('#topbarNotifWrap')) notifDrop.classList.remove('show');
    });

    function loadNotifications() {
        var list = document.getElementById('topbarNotifList');
        if (!list) return;
        fetch(CP + '/api/thong-bao', { headers: { Authorization: 'Bearer ' + token } })
        .then(function(r){ return r.ok ? r.json() : []; })
        .then(function(items) {
            var badge  = document.getElementById('topbarNotifBadge');
            var unread = items.filter(function(i){ return !i.daDoc; });
            if (badge) {
                badge.textContent   = unread.length > 9 ? '9+' : String(unread.length);
                badge.style.display = unread.length > 0 ? 'flex' : 'none';
            }
            if (!items.length) { list.innerHTML = '<div class="notif-empty">Không có thông báo mới.</div>'; return; }
            list.innerHTML = items.slice(0, 6).map(function(n){
                return '<a href="#" class="notif-item' + (!n.daDoc ? ' unread' : '') + '">'
                    + '<div class="notif-icon"><i class="bi bi-bell-fill"></i></div>'
                    + '<div class="notif-body"><strong>' + (n.tieuDe || 'Thông báo') + '</strong>'
                    + '<span>' + (n.noiDung || '') + '</span></div></a>';
            }).join('');
        })
        .catch(function(){ list.innerHTML = '<div class="notif-empty">Không tải được thông báo.</div>'; });
    }

    /* Logout */
    var logoutBtn = document.getElementById('topbarLogoutBtn');
    if (logoutBtn) logoutBtn.addEventListener('click', function() {
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        window.location.href = CP + '/login';
    });
})();
</script>