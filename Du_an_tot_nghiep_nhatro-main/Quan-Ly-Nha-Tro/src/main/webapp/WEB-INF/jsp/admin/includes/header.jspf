<%@ page pageEncoding="UTF-8" %>
<% response.setCharacterEncoding("UTF-8"); %>
<%
    String currentPath = request.getRequestURI();
    String contextPath = request.getContextPath();

    if (contextPath != null && !contextPath.isEmpty()) {
        currentPath = currentPath.substring(contextPath.length());
    }
%>

<!-- =====================================================
     ADMIN CSS
     ===================================================== -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
      href="${pageContext.request.contextPath}/resources/css/admin.css">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<!-- =====================================================
     SIDEBAR
     ===================================================== -->

<div class="sidebar">

    <div class="brand">
        <div class="brand-logo"><i class="bi bi-house-heart-fill"></i></div>
        <span>Room Connect</span>
        <small>ADMIN CONTROL CENTER</small>
    </div>

    <div class="nav-title">Tổng quan</div>

    <a class="side-link <%= currentPath.equals("/admin/dashboard") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/dashboard">
        <i class="bi bi-grid-1x2-fill"></i>
        <span>Dashboard</span>
    </a>


    <div class="nav-title">Kiểm duyệt</div>

    <a class="side-link <%= currentPath.equals("/admin/posts") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/posts">
        <i class="bi bi-house-check"></i>
        <span>Duyệt bài</span>
        <span class="badge-menu">12</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/ekyc") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/ekyc">
        <i class="bi bi-person-vcard"></i>
        <span>eKYC</span>
        <span class="badge-menu">7</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/reviews") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/reviews">
        <i class="bi bi-star"></i>
        <span>Đánh giá</span>
    </a>


    <div class="nav-title">Quản trị</div>

    <a class="side-link <%= currentPath.equals("/admin/users") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/users">
        <i class="bi bi-people"></i>
        <span>Người dùng</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/complaints") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/complaints">
        <i class="bi bi-flag"></i>
        <span>Khiếu nại</span>
        <span class="badge-menu">5</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/categories") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/categories">
        <i class="bi bi-tags"></i>
        <span>Danh mục</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/blog") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/blog">
        <i class="bi bi-newspaper"></i>
        <span>Blog</span>
    </a>


    <div class="nav-title">Tài chính & hệ thống</div>

    <a class="side-link <%= currentPath.equals("/admin/statistics") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/statistics">
        <i class="bi bi-bar-chart"></i>
        <span>Thống kê</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/revenue") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/revenue">
        <i class="bi bi-cash-stack"></i>
        <span>Doanh thu</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/transactions") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/transactions">
        <i class="bi bi-receipt"></i>
        <span>Giao dịch & hóa đơn</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/premium") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/premium">
        <i class="bi bi-gem"></i>
        <span>Premium</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/notifications") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/notifications">
        <i class="bi bi-bell"></i>
        <span>Thông báo</span>
    </a>

    <a class="side-link <%= currentPath.equals("/admin/activity-log") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/activity-log">
        <i class="bi bi-journal-text"></i>
        <span>Audit Log</span>
    </a>


    <div class="nav-title">AI Admin</div>

    <a class="side-link <%= currentPath.equals("/admin/ai") ? "active" : "" %>"
       href="${pageContext.request.contextPath}/admin/ai">
        <i class="bi bi-stars"></i>
        <span>Trung tâm AI</span>
    </a>


    <div class="nav-title">Hệ thống</div>

    <a class="side-link" href="${pageContext.request.contextPath}/">
        <i class="bi bi-house-door"></i>
        <span>Về trang chủ</span>
    </a>

</div>


<!-- =====================================================
     MAIN
     ===================================================== -->

<div class="main">

    <div class="topbar">

        <div>
            <input
                class="search"
                type="text"
                placeholder="Tìm kiếm nhanh..."
            >
        </div>

        <div class="userbox">

            <i class="bi bi-bell" style="font-size:20px;"></i>

            <div class="avatar">AD</div>

            <div>
                <b style="font-size:13px;">
                    ${not empty userName ? userName : 'Administrator'}
                </b>

                <div style="font-size:11px;color:#6b7280;">
                    Super Admin
                </div>
            </div>

        </div>

    </div>

    <div class="content">
